# 로컬: 이 파일을 .env.local 로 복사해 키를 채우세요 (.env.local 은 git 에 올라가지 않음)
# Vercel: Project Settings → Environment Variables 에 같은 이름으로 등록
# 키 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 선택: 모델 변경 (기본 gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash
# 선택: 생각 수준 minimal | low | medium | high (기본 low — 응답이 훨씬 빨라짐)
# GEMINI_THINKING_LEVEL=low

# 선택: 카카오 로컬 API 키 (REST API 키). 있으면 한국 카페/맛집/관광지 검색에 우선 사용
# 발급: https://developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키
KAKAO_REST_API_KEY=
